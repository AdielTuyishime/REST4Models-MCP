/*
 * ============================================================
 * SysML XMI -> JSON Model Transformation
 * ============================================================
 *
 * Source metamodel : SysML
 * Target metamodel : JSON
 *
 * Transformation idea:
 * - Each selected SysML element becomes a JSON Object
 * - Fields become JSON Members
 * - Primitive values become StringVal / BooleanVal / NumberVal
 * - Collections become Array
 *
 * Current scope:
 * - Namespace
 * - Package
 * - PartDefinition / PartUsage
 * - AttributeDefinition / AttributeUsage
 * - ItemDefinition / ItemUsage
 * - PortDefinition / PortUsage
 * - ReferenceUsage
 * - ActionDefinition / ActionUsage / PerformActionUsage
 * - StateDefinition / StateUsage
 * - ConnectionDefinition / ConnectionUsage
 */


/*
 * ============================================================
 * TRANSFORMATION RULES
 * ============================================================
 * Each rule maps one selected SysML element to one JSON Object.
 *
 * General pattern:
 * - the source SysML element becomes a JSON!Object
 * - basic metadata is exported as Members:
 *   - type
 *   - name
 *   - elementId
 * - nested contained elements are exported as Arrays of Objects
 * - optional typing information is exported when available
 */
 
 
/*
 * Map the root SysML Namespace to a JSON Object.
 *
 * Exported members:
 * - type      : "Namespace"
 * - name      : readable name of the namespace
 * - elementId : SysML identifier of the namespace
 * - packages  : array of top-level packages, if present
 * - elements  : array of semantic model elements contained in the model
 *
 * This rule creates the entry point of the target JSON model.
 */
rule Namespace2Object
	transform s : SysML!Namespace
	to t : JSON!Object {

	t.members.add(stringMember("type", "Namespace"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));

	var pkgs := s.topLevelPackages();
	if (not pkgs.isEmpty()) {
		t.members.add(objectArrayMember("packages", pkgs.equivalent()));
	}

	var elems := s.modelContentElements();
	if (not elems.isEmpty()) {
		t.members.add(objectArrayMember("elements", elems.equivalent()));
	}
}

/*
 * Map a SysML Package to a JSON Object.
 *
 * Exported members:
 * - type      : "Package"
 * - name      : package name
 * - elementId : package identifier
 * - packages  : nested packages, if present
 * - elements  : non-package semantic elements directly owned by the package
 *
 * This rule preserves the package hierarchy in the target JSON model.
 */
rule Package2Object
	transform s : SysML!Package
	to t : JSON!Object {

	t.members.add(stringMember("type", "Package"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));

	var nestedPkgs := s.nestedPackages();
	if (not nestedPkgs.isEmpty()) {
		t.members.add(objectArrayMember("packages", nestedPkgs.equivalent()));
	}

	var elems := s.directOwnedElements().select(e | not e.isKindOf(SysML!Package));
	if (not elems.isEmpty()) {
		t.members.add(objectArrayMember("elements", elems.equivalent()));
	}
}

/*
 * Map a SysML PartDefinition to a JSON Object.
 *
 * Exported members:
 * - type      : "PartDefinition"
 * - name      : part definition name
 * - elementId : SysML identifier
 * - features  : structural child members such as parts, attributes, ports, references
 *
 * Example:
 * PartDefinition Vehicle -> JSON Object with its owned structural features.
 */
rule PartDefinition2Object
	transform s : SysML!PartDefinition
	to t : JSON!Object {

	t.members.add(stringMember("type", "PartDefinition"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));

	var features := s.ownedStructuralMembers();
	if (not features.isEmpty()) {
		t.members.add(objectArrayMember("features", features.equivalent()));
	}
}

/*
 * Map a SysML PartUsage to a JSON Object.
 *
 * Exported members:
 * - type        : "PartUsage"
 * - name        : part usage name
 * - elementId   : SysML identifier
 * - typeRefName : referenced type name, if available
 * - typeRefId   : referenced type identifier, if available
 * - typeRefUri  : referenced type proxy URI, if unresolved
 * - features    : nested structural child members, if present
 *
 * This rule preserves both the usage itself and the type it points to.
 */
rule PartUsage2Object
	transform s : SysML!PartUsage
	to t : JSON!Object {

	t.members.add(stringMember("type", "PartUsage"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));

	if (s.hasTypingRelationship()) {
		t.members.add(stringMember("typeRefName", s.relationshipTypeRefName()));
		t.members.add(stringMember("typeRefId", s.relationshipTypeRefId()));
		t.members.add(stringMember("typeRefUri", s.relationshipTypeRefUri()));
	}

	var features := s.ownedStructuralMembers();
	if (not features.isEmpty()) {
		t.members.add(objectArrayMember("features", features.equivalent()));
	}
}

/*
 * Map a SysML AttributeDefinition to a JSON Object.
 *
 * Exported members:
 * - type      : "AttributeDefinition"
 * - name      : attribute definition name
 * - elementId : SysML identifier
 * - features  : nested structural members, if present
 *
 * This is useful when attribute definitions own additional nested elements.
 */
rule AttributeDefinition2Object
	transform s : SysML!AttributeDefinition
	to t : JSON!Object {

	t.members.add(stringMember("type", "AttributeDefinition"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));

	var features := s.ownedStructuralMembers();
	if (not features.isEmpty()) {
		t.members.add(objectArrayMember("features", features.equivalent()));
	}
}

/*
 * Map a SysML AttributeUsage to a JSON Object.
 *
 * Exported members:
 * - type        : "AttributeUsage"
 * - name        : attribute usage name
 * - elementId   : SysML identifier
 * - isComposite : boolean value, if defined
 * - typeRefName : referenced type name, if available
 * - typeRefId   : referenced type identifier, if available
 * - typeRefUri  : referenced type proxy URI, if unresolved
 *
 * This rule captures both the usage metadata and its typing information.
 */
rule AttributeUsage2Object
	transform s : SysML!AttributeUsage
	to t : JSON!Object {

	t.members.add(stringMember("type", "AttributeUsage"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));

	if (s.hasProperty("isComposite") and not s.isComposite.isUndefined()) {
		t.members.add(booleanMember("isComposite", s.isComposite));
	}

	if (s.hasTypingRelationship()) {
		t.members.add(stringMember("typeRefName", s.relationshipTypeRefName()));
		t.members.add(stringMember("typeRefId", s.relationshipTypeRefId()));
		t.members.add(stringMember("typeRefUri", s.relationshipTypeRefUri()));
	}
}


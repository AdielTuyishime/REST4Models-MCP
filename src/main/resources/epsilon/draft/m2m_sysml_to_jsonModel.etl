rule ReferenceUsage2Object
	transform s : SysML!ReferenceUsage
	to t : JSON!Object {

	t.members.add(stringMember("type", "ReferenceUsage"));
	t.members.add(stringMember("name", s.safeDeclaredName()));
	t.members.add(stringMember("elementId", s.safeElementId()));
}


/*
 * ============================================================
 * COMMON HELPER OPERATIONS
 * ============================================================
 */

/*
 * Return the best readable name for a SysML element.
 */
operation Any safeDeclaredName() : String {
	if (self.hasProperty("declaredName") and not self.declaredName.isUndefined()) {
		return self.declaredName;
	}
	if (self.hasProperty("name") and not self.name.isUndefined()) {
		return self.name;
	}
	return "";
}

/*
 * Return elementId if present.
 */
operation Any safeElementId() : String {
	if (self.hasProperty("elementId") and not self.elementId.isUndefined()) {
		return self.elementId;
	}
	return "";
}

/*
 * Safely return ownedRelationship.
 */
operation Any ownedRelationshipsSafe() {
	if (self.hasProperty("ownedRelationship") and not self.ownedRelationship.isUndefined()) {
		return self.ownedRelationship;
	}
	return Sequence{};
}

/*
 * Safely return ownedRelatedElement from a relationship.
 */
operation Any relatedElementsSafe() {
	if (self.hasProperty("ownedRelatedElement") and not self.ownedRelatedElement.isUndefined()) {
		if (self.ownedRelatedElement.isKindOf(Collection)) {
			return self.ownedRelatedElement;
		}
		return Sequence { self.ownedRelatedElement };
	}
	return Sequence{};
}

/*
 * Collect semantic child elements through:
 * ownedRelationship -> ownedRelatedElement
 */
operation Any directOwnedElements() {
	var result = Sequence{};
	for (rel in self.ownedRelationshipsSafe()) {
		for (elem in rel.relatedElementsSafe()) {
			result.add(elem);
		}
	}
	return result;
}

/*
 * Return direct semantic elements under the Namespace.
 */
operation SysML!Namespace topLevelOwnedElements() {
	return self.directOwnedElements();
}

/*
 * Return top-level packages.
 */
operation SysML!Namespace topLevelPackages() {
	return self.topLevelOwnedElements().select(e | e.isKindOf(SysML!Package));
}

/*
 * Return direct nested packages of a Package.
 */
operation SysML!Package nestedPackages() {
	return self.directOwnedElements().select(e | e.isKindOf(SysML!Package));
}

/*
 * Return all nested packages recursively, including the current package.
 */
operation SysML!Package allPackagesRecursively() {
	var result = Sequence{self};

	for (p in self.nestedPackages()) {
		for (child in p.allPackagesRecursively()) {
			if (not result.includes(child)) {
				result.add(child);
			}
		}
	}

	return result;
}

/*
 * Return all packages reachable from the Namespace.
 */
operation SysML!Namespace allPackagesRecursively() {
	var result = Sequence{};

	for (pkg in self.topLevelPackages()) {
		for (p in pkg.allPackagesRecursively()) {
			if (not result.includes(p)) {
				result.add(p);
			}
		}
	}

	return result;
}

/*
 * Return semantic elements directly owned by all reachable packages.
 */
operation SysML!Namespace packageOwnedElements() {
	var result = Sequence{};

	for (pkg in self.allPackagesRecursively()) {
		for (e in pkg.directOwnedElements()) {
			if (not result.includes(e)) {
				result.add(e);
			}
		}
	}

	return result;
}

/*
 * Return direct non-package elements under the Namespace.
 */
operation SysML!Namespace namespaceOwnedNonPackageElements() {
	return self.topLevelOwnedElements().select(e | not e.isKindOf(SysML!Package));
}

/*
 * Return the main semantic content of the model.
 * Merges:
 * - direct non-package Namespace elements
 * - elements inside nested packages
 */
operation SysML!Namespace modelContentElements() {
	var result = Sequence{};

	for (e in self.namespaceOwnedNonPackageElements()) {
		if (not result.includes(e)) {
			result.add(e);
		}
	}

	for (e in self.packageOwnedElements()) {
		if (not result.includes(e)) {
			result.add(e);
		}
	}

	return result;
}


/*
 * ============================================================
 * STRUCTURAL HELPERS
 * ============================================================
 */

/*
 * Return direct structural child members/usages.
 */
operation Any ownedStructuralMembers() {
	return self.directOwnedElements().select(e |
		e.isKindOf(SysML!AttributeUsage) or
		e.isKindOf(SysML!PartUsage) or
		e.isKindOf(SysML!ItemUsage) or
		e.isKindOf(SysML!PortUsage) or
		e.isKindOf(SysML!ReferenceUsage)
	);
}


/*
 * ============================================================
 * BEHAVIORAL HELPERS
 * ============================================================
 */

/*
 * Return direct behavioral child members.
 */
operation Any ownedBehavioralMembers() {
	return self.directOwnedElements().select(e |
		e.isKindOf(SysML!PerformActionUsage) or
		e.isKindOf(SysML!ActionUsage) or
		e.isKindOf(SysML!StateUsage)
	);
}


/*
 * ============================================================
 * RELATIONSHIP HELPERS
 * ============================================================
 */

/*
 * Return FeatureTyping relationships.
 */
operation Any typingRelationships() {
	return self.ownedRelationshipsSafe().select(r | r.eClass().name = "FeatureTyping");
}

/*
 * Check whether the element has typing relationships.
 */
operation Any hasTypingRelationship() : Boolean {
	return not self.typingRelationships().isEmpty();
}

/*
 * Resolve the type target from the first FeatureTyping relationship.
 */
operation Any typeTarget() {
	var typings = self.typingRelationships();
	if (typings.isEmpty()) return null;

	var typing = typings.first();

	if (typing.hasProperty("type") and not typing.type.isUndefined()) {
		return typing.type;
	}

	return null;
}

/*
 * Return referenced type declared name.
 */
operation Any relationshipTypeRefName() : String {
	var target = self.typeTarget();
	if (target.isUndefined()) return "";

	if (target.hasProperty("declaredName") and not target.declaredName.isUndefined()) {
		return target.declaredName;
	}

	return "";
}

/*
 * Return referenced type elementId.
 */
operation Any relationshipTypeRefId() : String {
	var target = self.typeTarget();
	if (target.isUndefined()) return "";

	if (target.hasProperty("elementId") and not target.elementId.isUndefined()) {
		return target.elementId;
	}

	return "";
}

/*
 * Return referenced type proxy URI when unresolved.
 */
operation Any relationshipTypeRefUri() : String {
	var target = self.typeTarget();
	if (target.isUndefined()) return "";

	if (target.eIsProxy()) {
		return target.eProxyURI().toString();
	}

	return "";
}


/*
 * ============================================================
 * JSON MODEL CONSTRUCTION HELPERS
 * ============================================================
 */

/*
 * Build a JSON object member whose value is a StringVal.
 */
operation stringMember(key : String, val : String) : JSON!Member {
	var m = new JSON!Member;
	m.key = key;

	var v = new JSON!StringVal;
	v.stringValue = val;

	m.value = v;
	return m;
}

/*
 * Build a JSON object member whose value is a BooleanVal.
 */
operation booleanMember(key : String, val : Boolean) : JSON!Member {
	var m = new JSON!Member;
	m.key = key;

	var v = new JSON!BooleanVal;
	v.booleanValue = val;

	m.value = v;
	return m;
}

/*
 * Build a JSON object member whose value is a NumberVal.
 * Adjust the cast if your NumberVal uses a different datatype.
 */
operation numberMember(key : String, val : Real) : JSON!Member {
	var m = new JSON!Member;
	m.key = key;

	var v = new JSON!NumberVal;
	v.numberValue = val;

	m.value = v;
	return m;
}

/*
 * Build a JSON object member whose value is Null.
 */
operation nullMember(key : String) : JSON!Member {
	var m = new JSON!Member;
	m.key = key;

	var v = new JSON!Null;
	m.value = v;

	return m;
}

/*
 * Build a JSON object member whose value is an Array
 * containing target JSON objects.
 */
operation objectArrayMember(key : String, elems : Collection) : JSON!Member {
	var m = new JSON!Member;
	m.key = key;

	var arr = new JSON!Array;
	for (e in elems) {
		arr.values.add(e);
	}

	m.value = arr;
	return m;
}